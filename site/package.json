{
  "name": "marbach-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --port 8787",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply marbach --local",
    "db:migrate:remote": "wrangler d1 migrations apply marbach --remote",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/seed.mjs --remote",
    "user:create": "node scripts/create-user.mjs",
    "deploy": "astro build && wrangler deploy",
    "images": "node scripts/build-images.mjs",
    "formspec": "node scripts/gen-formspec.mjs",
    "assets": "node scripts/prep-assets.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@fontsource-variable/assistant": "^5.2.0",
    "@fontsource-variable/frank-ruhl-libre": "^5.2.0",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "xss": "^1.0.16"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "wrangler": "^4.151.3"
  }
}
