---
import { img, heDate, articleUrl } from '../lib/data';
interface Props { article: { title: string; slug: string; date: string; excerpt: string; image?: string; imageAlt: string; sourceLabel: string } }
const { article: a } = Astro.props;
const th = a.image ? img(a.image, '(max-width: 760px) 100vw, 380px') : null;
---
<a class="card card-link article-card" href={articleUrl(a.slug)}>
  <div class="thumb">
    {th ? <img src={th.src} srcset={th.srcset} sizes={th.sizes} width={th.width} height={th.height} alt={a.imageAlt} loading="lazy" decoding="async" />
        : <div class="thumb-blank" aria-hidden="true"><svg viewBox="0 0 200 120"><g fill="none" stroke="currentColor" stroke-width=".8">{[16, 30, 44, 58, 72].map((r) => <circle cx="100" cy="128" r={r * 1.6} />)}</g></svg></div>}
  </div>
  <div class="body">
    <time datetime={a.date}>{heDate(a.date)}</time>
    <h3>{a.title}</h3>
    <p>{a.excerpt}</p>
  </div>
</a>
