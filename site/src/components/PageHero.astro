---
// The opening of every inner page: title + lead on the right, one drawing floating on the left (its own parallax
// layer), and the bells' rings behind both (a slower layer).
import Rings from './Rings.astro';
import { img } from '../lib/data';
interface Props { kicker?: string; title: string; intro?: string; art?: string }
const { kicker, title, intro, art } = Astro.props;
const a = art ? img(art, '(max-width: 760px) 78vw, 520px') : null;
---
<section class="page-hero" data-parallax>
  <Rings data-speed="0.12" />
  {a && <div class="art" data-speed="0.22" aria-hidden="true"><img src={a.src} srcset={a.srcset} sizes={a.sizes} width={a.width} height={a.height} alt="" decoding="async" fetchpriority="high" /></div>}
  <div class="shell">
    <div class="page-hero-copy">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      <slot />
    </div>
  </div>
</section>
