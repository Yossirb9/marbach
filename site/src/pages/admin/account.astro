---
import Admin from '../../layouts/Admin.astro';
const me = Astro.locals.user!;
---
<Admin title="החשבון שלי" screen="account" active="account">
  <h1>החשבון שלי</h1>
  <p class="lead">מחובר/ת בתור <strong dir="ltr">{me.username}</strong>.</p>
  <form id="pw" class="card narrow-form">
    <h2 class="h3">החלפת סיסמה</h2>
    <label class="field"><span class="label">הסיסמה הנוכחית</span><input class="input" type="password" name="current" autocomplete="current-password" dir="ltr" required /></label>
    <label class="field"><span class="label">סיסמה חדשה (6 תווים לפחות)</span><input class="input" type="password" name="next" autocomplete="new-password" dir="ltr" minlength="6" required /></label>
    <label class="field"><span class="label">שוב את הסיסמה החדשה</span><input class="input" type="password" name="again" autocomplete="new-password" dir="ltr" minlength="6" required /></label>
    <button class="btn btn-primary" type="submit">החלפת סיסמה</button>
    <p class="help">אחרי ההחלפה, כל מכשיר אחר שמחובר בחשבון הזה מתנתק.</p>
  </form>
</Admin>
