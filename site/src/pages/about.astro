---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import ContactBand from '../components/ContactBand.astro';
import { page, withBase } from '../lib/data';
// every text on this page: src/content/pages/about.json (CMS: עמודי האתר → אודות)
const p = await page('about');
const { story, facts, field } = p;
---
<Base title={p.seoTitle ?? p.title} description={p.seoDescription} image={story.image}>
  <PageHero kicker={p.kicker} title={p.title} intro={p.intro} art="/media/art/bells_cluster.png" />

  <section class="section">
    <div class="shell two-col story-grid">
      <article class="story" data-reveal>
        {story.title && <h2 class="h2">{story.title}</h2>}
        {story.blocks.map((b) => b.type === 'quote'
          ? <blockquote>{b.text}{b.cite && <cite>{b.cite}</cite>}</blockquote>
          : <p>{b.text}</p>)}
      </article>
      <aside class="about-side" data-reveal style="--d:.1s">
        <div class="arch" style="aspect-ratio:4/5"><Img src={story.image} alt={story.imageAlt} sizes="(max-width: 860px) 80vw, 380px" /></div>
        {story.button && <a class="btn btn-ghost" href={withBase('/video/')}>{story.button}</a>}
      </aside>
    </div>
  </section>

  {facts.items.length > 0 && (
    <section class="section section-paper2">
      <div class="shell">
        <div class="section-head" data-reveal>
          {facts.kicker && <p class="kicker">{facts.kicker}</p>}
          {facts.title && <h2 class="h2">{facts.title}</h2>}
        </div>
        <ol class="facts" data-reveal>
          {facts.items.map((f) => (
            <li>
              <strong>{f.title}</strong>
              <span>{f.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {field.image && (
    <section class="section section-tight clip">
      <div class="shell two-col">
        <div data-reveal>
          {field.kicker && <p class="kicker">{field.kicker}</p>}
          {field.title && <h2 class="h2">{field.title}</h2>}
        </div>
        <div class="arch" style="aspect-ratio:1;border-radius:var(--r);max-width:520px" data-reveal><Img src={field.image} alt={field.imageAlt} sizes="(max-width: 860px) 92vw, 520px" /></div>
      </div>
    </section>
  )}

  <ContactBand />
</Base>
